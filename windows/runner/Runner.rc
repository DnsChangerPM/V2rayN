// IranLink version resource. Version fields are stamped by
// scripts/set_version.py from the release workflow input.
#include "resource.h"

#include "winres.h"

IDI_APP_ICON            ICON                    "resources\\app_icon.ico"

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_ENU)
LANGUAGE 9, 1

1 VERSIONINFO
  FILEVERSION 0,1,0,0
  PRODUCTVERSION 0,1,0,0
  FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
  FILEFLAGS 0x1L
#else
  FILEFLAGS 0x0L
#endif
  FILEOS 0x40004L
  FILETYPE 0x1L
  FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904e4"
        BEGIN
            VALUE "CompanyName", "Parsa"
            VALUE "FileDescription", "IranLink — Windows proxy client (Xray-core)"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "IranLink"
            VALUE "OriginalFilename", "IranLink.exe"
            VALUE "ProductName", "IranLink"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END

#endif
