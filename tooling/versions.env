# IranLink pinned toolchain — single source of truth for reproducible builds.
# Sourced by GitHub Actions workflows and scripts/*.py.
# Verified 2026-09-10. See docs/windows-compatibility.md for evidence.

# Last Flutter/Dart line with official Windows 7/8 support
# (flutter-announce, 2024-02-15: "Dart 3.3 and Flutter 3.19 will be the last
# releases supporting Windows 7 and 8").
FLUTTER_VERSION=3.19.6
FLUTTER_CHANNEL=stable
DART_VERSION=3.3.4

# GitHub-hosted runner. windows-2022 ships Visual Studio 2022 which matches the
# Flutter 3.19 toolchain. There is no Windows 7 hosted runner; Win7/8.1 are
# validated via the strategy in docs/windows-compatibility.md.
RUNNER_OS=windows-2022

# Xray-core: latest STABLE release verified 2026-09-10.
# Both assets exist for this tag (verified via GitHub API):
#   Xray-windows-64.zip + .dgst   (primary core, Windows 10/11)
#   Xray-win7-64.zip + .dgst       (legacy core, Windows 7 SP1 / 8.1)
XRAY_VERSION=v26.3.27
XRAY_PRIMARY_ASSET=Xray-windows-64.zip
XRAY_LEGACY_ASSET=Xray-win7-64.zip

# Inno Setup 6: minimum supported OS is Windows 7 SP1 / Server 2008 R2
# (MinVersion defaults to 6.1sp1). Installed via Chocolatey, pinned.
INNO_VERSION=6.2.2

# Primary architecture. The pipeline is arch-parameterized for future x86/ARM64.
ARCH=x64
APP_ID=IraLink
APP_NAME=IranLink
APP_PUBLISHER=Parsa
APP_IDENTIFIER=com.parsa.iranlink
